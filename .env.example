NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DATA_DIR=/app/data
DASHBOARD_USERNAME=admin
# Required: set your own password of at least 16 characters.
DASHBOARD_PASSWORD=

# Required: same Google OAuth client and refresh token, authorized for BOTH scopes:
# https://www.googleapis.com/auth/analytics.readonly
# https://www.googleapis.com/auth/adwords
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GA4_PROPERTY_ID=378788930
GOOGLE_ADS_CUSTOMER_ID=9347478419
GOOGLE_ADS_API_VERSION=v25
# Optional: manager account used to access a child account (digits only).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: fill if required by your Google Ads API access configuration.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Required: a Meta token with ads_read and access to both ad accounts.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=222947167250427,844151987085048
META_API_VERSION=v26.0
# Optional: required if your Meta app requires appsecret_proof.
META_APP_SECRET=
